# Copy this file to .env.compose before running Docker Compose.
# Do not commit .env.compose.

# Local Docker PostgreSQL. The services override POSTGRES_HOST to "postgres".
POSTGRES_USER=dsm_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=dsm_db

# Containers use redis:6379. The host inspection port is fixed to 6380 in compose.yaml.
CACHE_ENABLED=true
CACHE_KEY_PREFIX=gbtac:v1
REDIS_CONNECT_TIMEOUT_SECONDS=1.5
REDIS_SOCKET_TIMEOUT_SECONDS=1.5

# Firebase Admin settings. Also copy the service-account JSON to:
# secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=gbtac-dsm
FIREBASE_CHECK_REVOKED_TOKENS=true

# Browser origins used when calling a backend port directly during debugging.
FRONTEND_ORIGINS=http://localhost:5500,http://localhost:8080

# Open-Meteo configuration.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_LOCATION_NAME=Calgary
WEATHER_LATITUDE=51.0447
WEATHER_LONGITUDE=-114.0719
WEATHER_TIMEZONE=America/Edmonton
WEATHER_CACHE_SECONDS=600
WEATHER_STALE_CACHE_SECONDS=21600
WEATHER_REQUEST_TIMEOUT_SECONDS=8
WEATHER_MAX_ATTEMPTS=2
WEATHER_SERVICE_TIMEOUT_SECONDS=10

# Optional OpenRouter explanation. Leave the key blank to use rule-based output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b

# Dashboard/cache settings.
DASHBOARD_OVERVIEW_CACHE_SECONDS=60
DASHBOARD_CHART_CACHE_SECONDS=300
ENERGY_CONSUMPTION_SENSOR_CODE=30000_TL342
ENERGY_COUNTER_DIRECTION=decreasing
CUMULATIVE_ENERGY_SENSOR_CODE=30000_TL342

# Recommendation rules. The application also has safe defaults.
RECOMMENDATION_SITE_POWER_SENSOR_CODE=30000_TL342
OVERNIGHT_BASELOAD_THRESHOLD_W=8000
PEAK_DEMAND_MINIMUM_W=15000
PEAK_DEMAND_RATIO=1.5
ECONOMIZER_MIN_INDOOR_C=22
ECONOMIZER_MIN_OUTDOOR_C=5
ECONOMIZER_TEMPERATURE_DIFFERENCE_C=2

# Historical import limits.
MAX_ROWS_PER_SENSOR=10000
IMPORT_CHUNK_SIZE=100000
INSERT_BATCH_SIZE=5000
INVALID_ABSOLUTE_VALUE=1e12
