# Database
DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/gbtac

# Frontend origins allowed to call FastAPI. Separate multiple URLs with commas.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Operator decision endpoint
DECISION_WRITE_KEY=replace-with-a-long-random-key
DECISION_OPERATOR_LABEL=GBTAC Operator

# Weather provider
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LOCATION_NAME=Calgary, Alberta
WEATHER_LATITUDE=51.0447
WEATHER_LONGITUDE=-114.0719
WEATHER_TIMEZONE=America/Edmonton
WEATHER_CACHE_SECONDS=600
WEATHER_STALE_CACHE_SECONDS=21600

# Redis cache
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=gbtac:v1

# Phase 5 recommendation rules (optional; defaults shown)
OCCUPIED_START_HOUR=7
OCCUPIED_END_HOUR=19
LIGHTING_AFTER_HOURS_THRESHOLD_KW=0.25
DHW_BASELINE_SAMPLE_COUNT=10000
DHW_SPIKE_RATIO=3.0
DHW_MINIMUM_TRIGGER_KW=0.15
WARM_WEATHER_THRESHOLD_C=20.0
HVAC_MINIMUM_TRIGGER_KW=0.5
HVAC_SITE_SHARE_THRESHOLD=0.15
