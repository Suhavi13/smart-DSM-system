POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gbtac_dsm

# Full inventory reading-import settings
MAX_ROWS_PER_SENSOR=10000
IMPORT_CHUNK_SIZE=100000
INSERT_BATCH_SIZE=5000
INVALID_ABSOLUTE_VALUE=1e12

# Redis cache
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=gbtac:v1

# Weather integration. The default Open-Meteo endpoint is suitable only when
# the client confirms the deployment qualifies for its non-commercial terms.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_LOCATION_NAME=Calgary, Alberta
WEATHER_LATITUDE=51.0447
WEATHER_LONGITUDE=-114.0719
WEATHER_TIMEZONE=America/Edmonton
WEATHER_CACHE_SECONDS=600
WEATHER_STALE_CACHE_SECONDS=21600
WEATHER_REQUEST_TIMEOUT_SECONDS=8


# Phase 5 recommendation thresholds
RECOMMENDATION_SITE_POWER_SENSOR_CODE=30000_TL342
OVERNIGHT_BASELOAD_THRESHOLD_W=8000
PEAK_DEMAND_MINIMUM_W=15000
PEAK_DEMAND_RATIO=1.5
ECONOMIZER_MIN_INDOOR_C=22
ECONOMIZER_MIN_OUTDOOR_C=5
ECONOMIZER_TEMPERATURE_DIFFERENCE_C=2


# Firebase Authentication (server-side). The service-account JSON must never
# be committed. Locally, set GOOGLE_APPLICATION_CREDENTIALS to its full path.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\firebase-service-account.json
# Optional alternative to GOOGLE_APPLICATION_CREDENTIALS:
FIREBASE_SERVICE_ACCOUNT_PATH=
# Checks disabled users and revoked sessions. Recommended for this operator app.
FIREBASE_CHECK_REVOKED_TOKENS=true

FRONTEND_ORIGINS=http://localhost:5500,http://localhost:5501,http://localhost:5173,http://127.0.0.1:5500,http://127.0.0.1:5501,http://127.0.0.1:5173
SERVE_FRONTEND=true

